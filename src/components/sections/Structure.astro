---
import { STRUCTURE } from '@/content/home';
import StateLattice from '@/components/motion/StateLattice.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Formula from '@/components/ui/Formula.astro';

// ===========================================================================
// SECTION C — the computational structure
// ---------------------------------------------------------------------------
// Editorial frame only. The animated diagram is `components/motion/StateLattice.astro`,
// which owns every animated property inside it.
//
// The rule, the legend and the benchmark contract are rendered as text as well
// as graphics: the diagram is a rendering of the update rule, and the rule is
// stated in full so nothing depends on seeing the animation.
// ===========================================================================
---

<section id="structure" class="border-t border-line">
  <div class="shell section-pad">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      {/*
        Six columns rather than five. At five the heading broke as
        "A state update, / coordinate by / coordinate." because the column was
        ~30px too narrow to hold "A state update, coordinate" on one line, and
        column 6 sat empty anyway.
      */}
      <div class="intro-rail lg:col-span-6">
        <Eyebrow number="02" label={STRUCTURE.eyebrow} />
        {/*
          No text-balance here. The column is ~544px and the heading is ~861px of
          type, so the browser balancing it produced three lines ending in a lone
          "by coordinate." Letting it fill naturally gives two.
        */}
        <h2 class="mt-8 text-display">{STRUCTURE.heading}</h2>
        <p class="mt-8 measure text-body text-ash">{STRUCTURE.intro}</p>
        <p class="mt-6 measure text-body text-ash">{STRUCTURE.whyItMatters}</p>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        {/*
          The rule is stated before the diagram, not after it. The diagram renders
          that rule; a reader who meets the drawing first has to reverse-engineer
          what it encodes. Order: rule, then the drawing, then the benchmark it was
          measured on.
        */}
        <div class="border-t border-line pt-6">
          <p class="label text-ash-dim">update rule</p>
          <Formula
            tokens={STRUCTURE.rule}
            class="tabular mt-4 block font-mono text-lead text-bone"
          />
          <Formula tokens={STRUCTURE.ruleCaption} class="mt-3 block text-caption text-ash-dim" />
        </div>

        <div class="mt-12">
          <StateLattice />
        </div>

        <div class="mt-12 border-t border-line pt-6">
          <p class="label text-ash-dim">benchmark</p>
          <p class="mt-3 font-display text-lead text-bone">{STRUCTURE.task.label}</p>
          <ul class="mt-4 grid gap-x-10 gap-y-2 sm:grid-cols-2">
            {
              STRUCTURE.task.facts.map((fact) => (
                <li class="font-mono text-label text-ash">{fact}</li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
