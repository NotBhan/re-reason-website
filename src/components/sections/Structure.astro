---
import { STRUCTURE } from '@/content/home';
import StateLattice from '@/components/motion/StateLattice.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';

// ===========================================================================
// SECTION C — the computational structure
// ---------------------------------------------------------------------------
// Editorial frame only. The animated diagram is `components/motion/StateLattice.astro`,
// which owns every animated property inside it.
//
// The rule, the legend and the benchmark contract are rendered as text as well
// as graphics: the diagram is a rendering of the update rule, and the rule is
// stated in full so nothing depends on seeing the animation.
// ===========================================================================
---

<section id="structure" class="border-t border-line">
  <div class="shell section-pad">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <Eyebrow number="02" label={STRUCTURE.eyebrow} />
        <h2 class="mt-8 text-display text-balance">{STRUCTURE.heading}</h2>
        <p class="mt-8 measure text-body text-ash">{STRUCTURE.intro}</p>
        <p class="mt-6 measure text-body text-ash">{STRUCTURE.whyItMatters}</p>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <StateLattice />

        <div class="mt-12 border-t border-line pt-6">
          <p class="label text-ash-dim">update rule</p>
          <p class="tabular mt-3 font-mono text-lead text-bone">{STRUCTURE.rule}</p>
          <p class="mt-2 text-caption text-ash-dim">{STRUCTURE.ruleCaption}</p>
        </div>

        <ul class="mt-8 flex flex-col gap-3">
          {
            STRUCTURE.diagram.legend.map((item) => (
              <li class="flex items-center gap-3">
                <span
                  class:list={[
                    'block h-2.5 w-3.5 shrink-0 border',
                    item.mark === 'hold' ? 'border-line-hi' : 'border-ash-dim bg-ash-dim',
                  ]}
                  aria-hidden="true"
                />
                <span class="label w-14 shrink-0 text-ash">{item.mark}</span>
                <span class="text-caption text-ash-dim">{item.meaning}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-12 border-t border-line pt-6">
          <p class="label text-ash-dim">benchmark</p>
          <p class="mt-3 font-display text-lead text-bone">{STRUCTURE.task.label}</p>
          <ul class="mt-4 grid gap-x-10 gap-y-2 sm:grid-cols-2">
            {
              STRUCTURE.task.facts.map((fact) => (
                <li class="font-mono text-label text-ash">{fact}</li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
