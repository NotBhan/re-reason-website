---
import { ACCESS } from '@/content/home';
import { linkFor } from '@/lib/site';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import ExternalLink from '@/components/ui/ExternalLink.astro';

// ===========================================================================
// SECTION E — access
// ---------------------------------------------------------------------------
// Closing composition. Every destination here is a verified, reachable URL;
// see LINKS in src/lib/site.ts. Nothing on this page links anywhere else.
//
// Animation ownership: CSS only — hover and focus transitions.
// ===========================================================================
---

<section id="access" class="border-t border-line">
  <div class="shell section-pad">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <Eyebrow number="04" label={ACCESS.eyebrow} />
        <h2 class="mt-8 text-display text-balance">{ACCESS.heading}</h2>
        <p class="mt-8 measure text-body text-ash">{ACCESS.intro}</p>
      </div>

      <ul class="lg:col-span-6 lg:col-start-7">
        {
          ACCESS.destinations.map((destination) => (
            <li class="border-t border-line last:border-b">
              <ExternalLink
                href={linkFor(destination.hrefKey)}
                cue={false}
                class="group block py-7"
              >
                <span class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
                  <span class="font-display text-lead text-bone transition-colors duration-200 ease-out group-hover:text-signal">
                    {destination.label}
                  </span>
                  <span class="flex items-baseline gap-4">
                    <span class="label text-ash-dim">{destination.meta}</span>
                    <span class="label text-ash-dim" aria-hidden="true">&nearr;</span>
                  </span>
                </span>
                <span class="mt-3 block measure text-body text-ash">
                  {destination.description}
                </span>
              </ExternalLink>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="measure-wide mt-20 border-t border-line pt-8 text-caption text-ash-dim sm:mt-28">
      {ACCESS.closing}
    </p>
  </div>
</section>
