---
// Wraps a rendered markdown body and styles its elements.
//
// The style block is global on purpose. Astro scopes component styles to the
// component's own template, and slotted markdown belongs to the *parent's*
// scope — so `:slotted()` was the obvious tool, but its rules are dropped by
// the CSS minifier in the production build and the body renders unstyled. A
// global block scoped by the `.research-prose` class is both correct and
// survives minification. Every selector below is prefixed with that class, so
// nothing leaks.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['research-prose', className]}>
  <slot />
</div>

<style is:global>
  .research-prose > :first-child {
    margin-top: 0;
  }

  .research-prose h2 {
    font-family: var(--font-display);
    /* Matches the Section component's heading register. These are the same
       level of thing in the reading order, so they must not be set at two
       different sizes. */
    font-size: var(--text-section);
    font-weight: 500;
    line-height: var(--text-section--line-height);
    letter-spacing: var(--text-section--letter-spacing);
    color: var(--color-bone);
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }

  .research-prose h3 {
    font-family: var(--font-display);
    font-size: var(--text-lead);
    font-weight: 500;
    color: var(--color-bone);
    margin-top: 2.5rem;
  }

  .research-prose p {
    font-family: var(--font-reading);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    color: var(--color-ash);
    max-width: 68ch;
    margin-top: 1.5rem;
  }

  .research-prose a {
    color: var(--color-bone);
    text-decoration: underline;
    text-decoration-color: var(--color-line-hi);
    text-underline-offset: 4px;
    transition: text-decoration-color 200ms ease-out;
  }

  .research-prose a:hover {
    text-decoration-color: var(--color-signal);
  }

  .research-prose ul,
  .research-prose ol {
    margin-top: 1.5rem;
    max-width: 68ch;
    display: grid;
    gap: 0.75rem;
  }

  .research-prose li {
    color: var(--color-ash);
    padding-left: 1.5rem;
    position: relative;
    line-height: var(--text-body--line-height);
  }

  .research-prose li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-line-hi);
  }

  .research-prose code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--color-bone);
  }

  .research-prose strong {
    color: var(--color-bone);
    font-weight: 500;
  }

  .research-prose blockquote {
    margin-top: 2rem;
    padding-left: 1.5rem;
    border-left: 1px solid var(--color-signal);
  }
</style>
