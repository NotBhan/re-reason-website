---
// A published research figure.
//
// The caption carries the interpretation; the alt text only describes what is
// on screen, because alt text is not a substitute for a reading of a chart. The
// context line is required by the content schema: a plot without the conditions
// it was measured under is not evidence.
import { repoBlob } from '@/lib/site';
import { pngSize } from '@/lib/figures';

interface Props {
  file: string;
  title: string;
  caption: string;
  context: string;
  alt: string;
  /** Repository path of the report that specifies this figure. */
  sourcePath: string;
  sourceLabel?: string;
}

const { file, title, caption, context, alt, sourcePath, sourceLabel } = Astro.props;
const size = pngSize(file);
---

<figure class="mt-14 border-t border-line pt-8">
  <div class="border border-line bg-surface p-3 sm:p-4">
    <img
      src={`/figures/${file}`}
      alt={alt}
      width={size.width}
      height={size.height}
      loading="lazy"
      decoding="async"
      class="h-auto w-full"
    />
  </div>

  <figcaption class="mt-6 grid gap-x-16 gap-y-5 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="label text-ash-dim">Figure</p>
      <p class="mt-3 font-display text-lead text-bone">{title}</p>
    </div>

    <div class="lg:col-span-8">
      <p class="measure-wide text-body text-ash">{caption}</p>
      <p class="measure-wide mt-4 border-l border-line pl-4 text-caption text-ash-dim">
        {context}
      </p>
      <p class="mt-5">
        <a
          href={repoBlob(sourcePath)}
          target="_blank"
          rel="noopener noreferrer"
          class="mono text-ash-dim transition-colors duration-200 ease-out hover:text-bone"
        >
          {sourceLabel ?? sourcePath}
          <span class="ml-1.5" aria-hidden="true">&nearr;</span>
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      </p>
    </div>
  </figcaption>
</figure>
