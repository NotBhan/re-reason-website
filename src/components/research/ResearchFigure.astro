---
// A published research figure.
//
// Presentation notes, all of which matter for the evidence reading:
//
//  - The chart is presented as a **plate**: a hairline box flush to the image, with
//    no dark padding around it. The plots are rendered on a light ground by the
//    analysis scripts and that ground is part of the figure. Framing it inside a
//    dark surface produced a double frame and made the light ground look like a
//    mistake rather than a deliberate plate against the dark page.
//
//  - The image is never recoloured, cropped or filtered. Chart values, axes and
//    labels are evidence.
//
//  - The caption carries the interpretation; the alt text only describes what is
//    on screen. Alt text is not a substitute for a reading of a chart.
//
//  - `context` is required by the content schema. A plot without the conditions it
//    was measured under is not evidence, so it travels with the figure.
//
//  - A full-resolution link is offered because a two-panel chart cannot be made
//    legible at a 350px viewport, and magnifying the raster would be misleading.
import { repoBlob } from '@/lib/site';
import { pngSize } from '@/lib/figures';

interface Props {
  file: string;
  title: string;
  caption: string;
  context: string;
  alt: string;
  /** Repository path of the report that specifies this figure. */
  sourcePath: string;
  sourceLabel?: string;
}

const { file, title, caption, context, alt, sourcePath, sourceLabel } = Astro.props;
const size = pngSize(file);
---

<figure class="mt-16 border-t border-line pt-8">
  <div class="border border-line">
    <img
      src={`/figures/${file}`}
      alt={alt}
      width={size.width}
      height={size.height}
      loading="lazy"
      decoding="async"
      class="block h-auto w-full"
    />
  </div>

  <figcaption class="mt-7 grid gap-x-16 gap-y-6 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="label text-ash-dim">Figure</p>
      <p class="mt-4 font-display text-section font-medium text-balance text-bone">{title}</p>
    </div>

    <div class="lg:col-span-8">
      <p class="max-w-[68ch] text-body text-ash">{caption}</p>

      <p class="mt-5 max-w-[68ch] border-l border-line pl-5 text-caption text-ash-dim">
        {context}
      </p>

      <p class="mt-6 flex flex-wrap items-baseline gap-x-8 gap-y-2">
        {/*
          Explicit margins rather than relying on whitespace between the text and
          the spans: the template compiler trims that whitespace, which rendered
          this as "Full resolution(1246x616)" with no space.
        */}
        <a
          href={`/figures/${file}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mono text-ash underline decoration-line-hi underline-offset-4 transition-colors duration-200 ease-out hover:text-bone hover:decoration-signal"
        >
          Full resolution
          <span class="ml-1.5 text-ash-dim">({size.width}&times;{size.height})</span>
          <span class="ml-1.5" aria-hidden="true">&nearr;</span>
          <span class="sr-only"> (opens in a new tab)</span>
        </a>

        <a
          href={repoBlob(sourcePath)}
          target="_blank"
          rel="noopener noreferrer"
          class="mono text-ash-dim transition-colors duration-200 ease-out [overflow-wrap:anywhere] hover:text-bone"
        >
          {sourceLabel ?? sourcePath}
          <span class="ml-1.5" aria-hidden="true">&nearr;</span>
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      </p>
    </div>
  </figcaption>
</figure>
