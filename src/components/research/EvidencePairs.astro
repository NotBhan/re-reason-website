---
// What the evidence establishes, next to what it does not.
//
// This pairing is the project's own format: its reports carry both sections for
// every experiment. Splitting them into two columns rather than running them
// together is the point — a reader should not be able to take the first half
// without seeing the second.
interface Props {
  establishes: string;
  doesNotEstablish: string;
}

const { establishes, doesNotEstablish } = Astro.props;
---

<dl class="mt-16 grid gap-x-16 gap-y-10 border-t border-line pt-8 lg:grid-cols-2">
  <div>
    <dt class="label text-bone">Establishes</dt>
    <dd class="measure-read mt-5 text-body text-ash">{establishes}</dd>
  </div>
  <div>
    <dt class="label text-signal">Does not establish</dt>
    <dd class="measure-read mt-5 text-body text-ash">{doesNotEstablish}</dd>
  </div>
</dl>
