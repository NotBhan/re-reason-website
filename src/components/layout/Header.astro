---
import { LINKS, ROUTES, SECTIONS } from '@/lib/site';
import ExternalLink from '@/components/ui/ExternalLink.astro';

// Static Astro markup, no client-side JavaScript.
//
// Deliberate responsive split: the section list lives in the header on large
// screens, and on small screens it moves into the hero's numbered contents
// index instead of hiding behind a menu button. Nothing here needs a script.
//
// The section anchors only exist on the homepage, so they are only rendered
// there. Showing them on a research page would be a set of links to nowhere.
//
// Active route: the research link is marked current whenever the path is under
// /research, via aria-current, so the state is announced and not conveyed by
// colour alone.
const path = Astro.url.pathname;
const isHome = path === '/' || path === '';
const onResearch = path.startsWith('/research');
---

<header class="sticky top-0 z-50 border-b border-line bg-ink">
  <div class="shell flex h-16 items-center justify-between gap-6">
    <a
      href={ROUTES.home}
      aria-label="RE:REASON — home"
      class="font-display text-caption font-medium tracking-[0.2em] text-bone uppercase transition-colors duration-200 ease-out hover:text-signal"
    >
      RE<span class="text-signal">:</span>REASON
    </a>

    <div class="flex items-center gap-3 sm:gap-7">
      <nav aria-label="Primary" class="flex items-center gap-3 sm:gap-7">
        <a
          href={ROUTES.research}
          aria-current={onResearch ? 'true' : undefined}
          class:list={[
            'label whitespace-nowrap transition-colors duration-200 ease-out',
            onResearch
              ? 'text-bone underline decoration-signal decoration-1 underline-offset-[6px]'
              : 'text-ash hover:text-bone',
          ]}
        >
          Research
        </a>

        {
          isHome && (
            <div class="hidden items-center gap-7 lg:flex">
              {SECTIONS.map((section) => (
                <a
                  href={`#${section.id}`}
                  class="label whitespace-nowrap text-ash transition-colors duration-200 ease-out hover:text-bone"
                >
                  <span class="tabular mr-2 text-ash-dim">{section.number}</span>
                  {section.label}
                </a>
              ))}
            </div>
          )
        }
      </nav>

      {/*
        whitespace-nowrap matters here. Without it the label and the arrow wrap
        independently at narrow widths, which produced a three-line-tall button
        inside a 64px header.

        The label also shortens below sm. With the full word and nowrap, the
        header overflowed a 360px viewport by ~19px: wordmark + Research +
        "Repository" simply does not fit in 320px of usable width. "Repo" is the
        conventional shorthand and is what the accessible name resolves to at
        that width, since the hidden span is not rendered.
      */}
      <ExternalLink
        href={LINKS.repository}
        cue={false}
        class="label whitespace-nowrap border border-control px-2.5 py-2 text-ash transition-colors duration-200 ease-out hover:border-signal hover:text-bone sm:px-3"
      >
        <span class="sm:hidden">Repo</span>
        <span class="hidden sm:inline">Repository</span>
        <span class="ml-1.5" aria-hidden="true">&nearr;</span>
      </ExternalLink>
    </div>
  </div>
</header>
