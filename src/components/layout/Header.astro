---
import { LINKS, SECTIONS } from '@/lib/site';
import ExternalLink from '@/components/ui/ExternalLink.astro';

// Static Astro markup, no client-side JavaScript.
//
// Deliberate responsive split: the section list lives in the header on large
// screens, and on small screens it moves into the hero's numbered contents
// index instead of hiding behind a menu button. Nothing here needs a script.
---

<header class="sticky top-0 z-50 border-b border-line bg-ink">
  <div class="shell flex h-16 items-center justify-between gap-6">
    <a
      href="#top"
      class="font-display text-caption font-medium tracking-[0.2em] text-bone uppercase transition-colors duration-200 ease-out hover:text-signal"
    >
      RE<span class="text-signal">:</span>REASON
    </a>

    <div class="flex items-center gap-5 sm:gap-7">
      <nav aria-label="Sections" class="hidden items-center gap-7 lg:flex">
        {
          SECTIONS.map((section) => (
            <a
              href={`#${section.id}`}
              class="label text-ash transition-colors duration-200 ease-out hover:text-bone"
            >
              <span class="tabular mr-2 text-ash-dim">{section.number}</span>
              {section.label}
            </a>
          ))
        }
      </nav>

      <ExternalLink
        href={LINKS.repository}
        cue={false}
        class="label border border-control px-3 py-2 text-ash transition-colors duration-200 ease-out hover:border-signal hover:text-bone"
      >
        Repository
        <span class="ml-1.5" aria-hidden="true">&nearr;</span>
      </ExternalLink>
    </div>
  </div>
</header>
