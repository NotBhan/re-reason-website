---
import { getCollection, render } from 'astro:content';
import Breadcrumbs from '@/components/research/Breadcrumbs.astro';
import PageHeader from '@/components/research/PageHeader.astro';
import PointList from '@/components/research/PointList.astro';
import Prose from '@/components/research/Prose.astro';
import RelatedEntries from '@/components/research/RelatedEntries.astro';
import ResearchFigure from '@/components/research/ResearchFigure.astro';
import ResultRows from '@/components/research/ResultRows.astro';
import Section from '@/components/research/Section.astro';
import SourceList from '@/components/research/SourceList.astro';
import ResearchLayout from '@/layouts/ResearchLayout.astro';
import { resolveRelated } from '@/lib/research';

// Phase detail template.
//
// Phases are the only template that shows decisions as a first-class block,
// because a phase's outcome is usually a decision — and on this project those
// decisions have mostly been NO-GO. Presenting them as a list of labelled
// outcomes keeps a closed or refused phase from reading as a success merely
// because documentation exists for it.
export async function getStaticPaths() {
  const entries = await getCollection('phases');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const related = await resolveRelated(data.related);

const STATUS_LABEL: Record<string, string> = {
  closed: 'Closed',
  proposed: 'Proposed — not fully authorized',
  'in-progress': 'In progress',
};
---

<ResearchLayout
  title={`Phase ${data.number} — ${data.title} — RE:REASON`}
  description={data.summary}
>
  <Breadcrumbs
    trail={[
      { label: 'Research', href: '/research' },
      { label: 'Phases', href: '/research/phases' },
      { label: `Phase ${data.number}` },
    ]}
  />

  <PageHeader
    kind="Phase"
    badge={data.number}
    title={data.title}
    summary={data.summary}
    meta={[
      { label: 'Status', value: STATUS_LABEL[data.status] ?? data.status },
      { label: 'Dated', value: data.date },
      { label: 'Scope', value: data.scope.length > 160 ? 'See below' : data.scope },
    ]}
  />

  <Section label="Objectives">
    <PointList items={data.objectives} ordered />
  </Section>

  <Section label="Scope">
    <p class="measure-wide text-body text-ash">{data.scope}</p>
  </Section>

  {
    data.results.length > 0 && (
      <Section label="Results">
        <ResultRows rows={data.results} />
      </Section>
    )
  }

  <Section label="Decisions">
    <dl class="border-t border-line">
      {data.decisions.map((decision) => (
        <div class="grid gap-x-16 gap-y-3 border-b border-line py-6 sm:grid-cols-[16rem_1fr]">
          <dt class="font-display text-lead text-bone">{decision.label}</dt>
          <dd class="measure text-body text-ash">{decision.outcome}</dd>
        </div>
      ))}
    </dl>
  </Section>

  {
    data.notPlanned.length > 0 && (
      <Section label="Not planned">
        <PointList items={data.notPlanned} />
      </Section>
    )
  }

  {
    data.figures.map((figure) => (
      <ResearchFigure
        file={figure.file}
        title={figure.title}
        caption={figure.caption}
        context={figure.context}
        alt={figure.alt}
        sourcePath={data.sources[0].path}
      />
    ))
  }

  <Prose class="mt-16">
    <Content />
  </Prose>

  <Section label="Source documents">
    <SourceList refs={data.sources} />
  </Section>

  {
    data.artifacts.length > 0 && (
      <Section label="Artifacts">
        <SourceList refs={data.artifacts} />
      </Section>
    )
  }

  <RelatedEntries entries={related} />
</ResearchLayout>
