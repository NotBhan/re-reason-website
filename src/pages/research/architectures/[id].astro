---
import { getCollection, render } from 'astro:content';
import Breadcrumbs from '@/components/research/Breadcrumbs.astro';
import ContentsNav from '@/components/research/ContentsNav.astro';
import Formula from '@/components/ui/Formula.astro';
import PageHeader from '@/components/research/PageHeader.astro';
import PointList from '@/components/research/PointList.astro';
import Prose from '@/components/research/Prose.astro';
import RelatedEntries from '@/components/research/RelatedEntries.astro';
import ResearchFigure from '@/components/research/ResearchFigure.astro';
import Section from '@/components/research/Section.astro';
import SourceList from '@/components/research/SourceList.astro';
import ResearchLayout from '@/layouts/ResearchLayout.astro';
import { resolveRelated } from '@/lib/research';

// Architecture detail template.
//
// Deliberately a different shape from the experiment template. An architecture
// has no "what this does not establish" in the experimental sense, so instead
// it carries an explicit implementation status and a list of unresolved design
// questions. That distinction is the reason these are separate collections
// rather than one schema with most fields optional.
export async function getStaticPaths() {
  const entries = await getCollection('architectures');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const related = await resolveRelated(data.related);

/** One source for section labels; the nav and the sections both read from it. */
const S = {
  purpose: { id: 'purpose', label: 'Purpose' },
  rule: { id: 'update-rule', label: 'Update rule' },
  components: { id: 'components', label: 'Components' },
  constraints: { id: 'constraints', label: 'Constraints' },
  questions: { id: 'open-questions', label: 'Open questions' },
  sources: { id: 'source-documents', label: 'Source documents' },
  related: { id: 'related', label: 'Related' },
} as const;

const contents = [
  S.purpose,
  ...(data.updateRule ? [S.rule] : []),
  S.components,
  ...(data.constraints.length > 0 ? [S.constraints] : []),
  ...(data.openQuestions.length > 0 ? [S.questions] : []),
  S.sources,
  S.related,
];

const IMPLEMENTATION_LABEL: Record<'implemented' | 'not-implemented', string> = {
  implemented: 'Implemented',
  'not-implemented': 'Not implemented — documented design',
};
---

<ResearchLayout
  title={`${data.title} — Architecture — RE:REASON`}
  description={data.summary}
>
  <Breadcrumbs
    trail={[
      { label: 'Research', href: '/research' },
      { label: 'Architectures', href: '/research/architectures' },
      { label: data.title },
    ]}
  />

  <PageHeader
    kind="Architecture"
    title={data.title}
    summary={data.summary}
    meta={[
      { label: 'Implementation', value: IMPLEMENTATION_LABEL[data.implementation] },
      { label: 'Status', value: data.status },
      { label: 'Source of record', value: 'Research repository' },
    ]}
  />

  {
    data.implementation === 'not-implemented' && (
      <p class="measure-read mt-12 border-l border-signal pl-5 text-body text-ash">
        This design was specified and then not built. It is published because the reasons it
        was set aside are part of the project's result, not because it describes a running
        system.
      </p>
    )
  }

  <ContentsNav items={contents} />

  <Section id={S.purpose.id} label={S.purpose.label}>
    <p class="measure-read text-body text-ash">{data.purpose}</p>
  </Section>

  {
    data.updateRule && (
      <Section id={S.rule.id} label={S.rule.label}>
        <Formula tokens={data.updateRule} class="tabular block font-mono text-lead text-bone" />
        {data.updateRuleNote && (
          <p class="measure-read mt-5 text-caption text-ash-dim">{data.updateRuleNote}</p>
        )}
      </Section>
    )
  }

  <Section id={S.components.id} label={S.components.label}>
    <dl class="border-t border-line">
      {
        data.components.map((component) => (
          <div class="grid gap-x-16 gap-y-3 border-b border-line py-6 sm:grid-cols-[15rem_1fr]">
            <dt class="font-display text-lead text-bone">{component.name}</dt>
            <dd class="measure-read text-body text-ash">{component.detail}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  {
    data.constraints.length > 0 && (
      <Section id={S.constraints.id} label={S.constraints.label}>
        <PointList items={data.constraints} />
      </Section>
    )
  }

  {
    data.openQuestions.length > 0 && (
      <Section id={S.questions.id} label={S.questions.label}>
        <PointList items={data.openQuestions} />
      </Section>
    )
  }

  {
    data.figures.map((figure) => (
      <ResearchFigure
        file={figure.file}
        title={figure.title}
        caption={figure.caption}
        context={figure.context}
        alt={figure.alt}
        sourcePath={data.sources[0].path}
      />
    ))
  }

  <Prose class="mt-16">
    <Content />
  </Prose>

  <Section id={S.sources.id} label={S.sources.label}>
    <SourceList refs={data.sources} />
  </Section>

  <RelatedEntries entries={related} />
</ResearchLayout>
