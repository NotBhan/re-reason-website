---
import { getCollection, render } from 'astro:content';
import Breadcrumbs from '@/components/research/Breadcrumbs.astro';
import ContentsNav from '@/components/research/ContentsNav.astro';
import EvidencePairs from '@/components/research/EvidencePairs.astro';
import PageHeader from '@/components/research/PageHeader.astro';
import PointList from '@/components/research/PointList.astro';
import Prose from '@/components/research/Prose.astro';
import RelatedEntries from '@/components/research/RelatedEntries.astro';
import ResearchFigure from '@/components/research/ResearchFigure.astro';
import ResultRows from '@/components/research/ResultRows.astro';
import Section from '@/components/research/Section.astro';
import SourceList from '@/components/research/SourceList.astro';
import ResearchLayout from '@/layouts/ResearchLayout.astro';
import { resolveRelated } from '@/lib/research';

// Experiment detail template.
//
// The page order follows the order a reader needs in order to judge the result
// rather than the order the report happens to use: question, motivation, what
// was held fixed, how it was measured, what was measured, what that supports,
// what it does not, and only then the longer interpretation. Limitations sit
// above the figures on purpose — a plot should not be met without them.
export async function getStaticPaths() {
  const entries = await getCollection('experiments');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const related = await resolveRelated(data.related);

/*
  One source for section labels. The contents nav and the sections themselves
  both read from here, so a heading cannot be renamed in one place and left
  stale in the other, and the anchor ids cannot drift from the nav targets.
*/
const S = {
  question: { id: 'research-question', label: 'Research question' },
  motivation: { id: 'motivation', label: 'Motivation' },
  frozen: { id: 'held-fixed', label: 'Held fixed' },
  procedure: { id: 'procedure', label: 'Procedure' },
  results: { id: 'results', label: 'Results' },
  limitations: { id: 'limitations', label: 'Limitations' },
  next: { id: 'next-step', label: 'Next step' },
  sources: { id: 'source-report', label: 'Source report' },
  artifacts: { id: 'artifacts', label: 'Reproducibility artifacts' },
  related: { id: 'related', label: 'Related' },
} as const;

const contents = [
  S.question,
  S.motivation,
  S.frozen,
  S.procedure,
  S.results,
  S.limitations,
  ...(data.nextStep ? [S.next] : []),
  S.sources,
  ...(data.artifacts.length > 0 ? [S.artifacts] : []),
  S.related,
];
---

<ResearchLayout
  title={`Experiment ${data.identifier} — ${data.title} — RE:REASON`}
  description={data.summary}
  ogType="article"
>
  <Breadcrumbs
    trail={[
      { label: 'Research', href: '/research' },
      { label: 'Experiments', href: '/research/experiments' },
      { label: `Experiment ${data.identifier}` },
    ]}
  />

  <PageHeader
    kind="Experiment"
    badge={data.identifier}
    title={data.title}
    summary={data.summary}
    meta={[
      { label: 'Status', value: 'Completed' },
      { label: 'Completed', value: data.date },
      { label: 'Classification', value: data.classification },
    ]}
  />

  <ContentsNav items={contents} />

  <Section id={S.question.id} label={S.question.label}>
    <p class="measure-read font-display text-lead text-bone">{data.question}</p>
  </Section>

  <Section id={S.motivation.id} label={S.motivation.label}>
    <p class="measure-read text-body text-ash">{data.motivation}</p>
  </Section>

  <Section id={S.frozen.id} label={S.frozen.label}>
    <PointList items={data.frozen} />
  </Section>

  <Section id={S.procedure.id} label={S.procedure.label}>
    <PointList items={data.procedure} ordered />
  </Section>

  <Section id={S.results.id} label={S.results.label}>
    <ResultRows rows={data.results} />
  </Section>

  <EvidencePairs establishes={data.establishes} doesNotEstablish={data.doesNotEstablish} />

  <Section id={S.limitations.id} label={S.limitations.label}>
    <PointList items={data.limitations} />
  </Section>

  {
    data.nextStep && (
      <Section id={S.next.id} label={S.next.label}>
        <p class="measure-read text-body text-ash">{data.nextStep}</p>
      </Section>
    )
  }

  {
    data.figures.map((figure) => (
      <ResearchFigure
        file={figure.file}
        title={figure.title}
        caption={figure.caption}
        context={figure.context}
        alt={figure.alt}
        sourcePath={data.sources[0].path}
      />
    ))
  }

  <Prose class="mt-16">
    <Content />
  </Prose>

  <Section id={S.sources.id} label={S.sources.label}>
    <SourceList refs={data.sources} dense />
  </Section>

  {
    data.artifacts.length > 0 && (
      <Section id={S.artifacts.id} label={S.artifacts.label}>
        <SourceList refs={data.artifacts} />
      </Section>
    )
  }

  <RelatedEntries entries={related} />
</ResearchLayout>
